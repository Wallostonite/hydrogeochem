# Copy to .env for local development. Every setting is optional; these are the defaults
# that differ from the built-in ones.
HGC_ENV=local
HGC_LOG_FORMAT=console

HGC_DATABASE_URL=postgresql+psycopg://hgc:hgc@localhost:5432/hgc
HGC_REDIS_URL=redis://localhost:6379/0

HGC_PHREEQC_DATABASE_DIR=./ops/phreeqc-databases
HGC_PHREEQC_WORKERS=4
HGC_PHREEQC_TIMEOUT_S=20

# Comma-separated. Leave empty in local/test to run without authentication.
HGC_API_KEYS=
HGC_JWT_SECRET=change-me
HGC_CORS_ORIGINS=http://localhost:8501

# The saturation-index time series and the ML dataset export fire several runs per click.
# The default 10/min ceiling trips easily locally; raise it for dev. Keep the default in prod.
HGC_RATE_LIMIT_RUNS_PER_MINUTE=120

# UI only
HGC_API_URL=http://localhost:8000
